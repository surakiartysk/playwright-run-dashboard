# Headers Pages adds to every page of the UI. The API's paths are answered by
# the Worker, which sets its own; see packages/api/src/index.ts.
#
# Cross-Origin-Opener-Policy: a report is served from this origin, and a
# script inside one could otherwise open this page in a new window and read
# what it shows. Reports deliberately do not carry it — see decision 40.
#
# frame-ancestors: no other site may frame the dashboard. SameSite=Lax already
# means a framed copy is signed out; this means it does not render at all.
#
# The rest of the policy (decision 48): scripts only from this origin, so the page
# has no inline script and no eval; styles may be inline, because the UI sets every
# style through React's style attribute and its palette lives in a <style> block;
# the fonts are Google's, and nothing else is fetched from anywhere but here.

/*
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
