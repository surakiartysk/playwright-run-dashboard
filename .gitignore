dist/
build/

# Wrangler local state — the local D1 database and R2 bucket live here.
# Generated by `wrangler dev`; `pnpm db:migrate` rebuilds them.
.wrangler/
.dev.vars

# Env — nothing here needs real secrets, but never let one slip in
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# The leak checker word list — local only, never published.
# See the note at the top of scripts/check-leak.mjs.
.leakwords.json
