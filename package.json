{
  "name": "playwright-run-dashboard",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Self-service test running: a developer picks a slice, presses Run, and gets a link to the report — without waiting on anyone.",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,ui -c blue,magenta \"pnpm --filter @run-dashboard/api dev\" \"pnpm --filter @run-dashboard/ui dev\"",
    "db:migrate": "pnpm --filter @run-dashboard/api db:migrate",
    "db:reset": "pnpm --filter @run-dashboard/api db:reset",
    "test": "pnpm -r --sequential test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r type-check",
    "check:claims": "node scripts/check-claims.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm check:claims",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
